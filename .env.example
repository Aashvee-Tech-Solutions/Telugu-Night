# Environment Configuration for Deployment
NODE_ENV=production

# Database Configuration
# Set FORCE_MEM_STORAGE=true to bypass database connection issues during deployment
FORCE_MEM_STORAGE=true
# DATABASE_URL=your_database_url_here (when database is available)

# Admin Configuration
# REQUIRED in production - set a secure password
ADMIN_USERNAME=aashvee
ADMIN_PASSWORD=Rudra@78611

# Cashfree Payment Configuration
# REQUIRED for payment processing
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
CASHFREE_WEBHOOK_SECRET=your_webhook_secret

# Optional: Override Cashfree environment
# CASHFREE_ENV=sandbox  # or 'production'

# Email Configuration (if needed)
# SMTP configuration for email services
# SMTP_HOST=your_smtp_host
# SMTP_PORT=587
# SMTP_USER=your_email_user
# SMTP_PASS=your_email_password

# Google Services (if needed)
# GOOGLE_SERVICE_ACCOUNT_KEY=your_google_service_key
# GOOGLE_SHEETS_ID=your_sheets_id